{
  "name": "@autevo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate && tsx scripts/generate-tenant-fallback.ts",
    "db:push": "prisma db push && tsx scripts/generate-tenant-fallback.ts",
    "db:migrate": "prisma migrate dev && tsx scripts/generate-tenant-fallback.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1"
  },
  "devDependencies": {
    "prisma": "^6.19.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
